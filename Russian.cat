                <selectionEntry type="model" import="true" name="Barclay de Tolly" hidden="false" id="72ee-e52f-c1a8-86dd">
                  <profiles>
                    <profile name="Barclay de Tolly" typeName="Cmd Unit" typeId="pt-CmdUnit">
                      <characteristics>
                        <characteristic typeId="ct-CmdUnit-Cmd" name="Cmd">2</characteristic>
                        <characteristic typeId="ct-CmdUnit-Move" name="___Move___">24 | 18 | 9</characteristic>
                        <characteristic typeId="ct-CmdUnit-Thr-LR" name="Thr-LR">1</characteristic>
                        <characteristic typeId="ct-CmdUnit-Thr-SR" name="Thr-SR">1</characteristic>
                        <characteristic typeId="ct-CmdUnit-Thr-C" name="Thr-C">1</characteristic>
                        <characteristic typeId="ct-CmdUnit-Coh" name="Coh">2</characteristic>
                        <characteristic typeId="ct-CmdUnit-Trait" name="Trait">Not from Around Here; Born in Germany to a Scottish family, Barclay is new to the Russian nobility and actively disliked by Chistoi Russkoi, i.e. “pure” Russians.</characteristic>
                        <characteristic typeId="ct-CmdUnit-Avail-Formation" name="AvForm">Late War</characteristic>
                        <characteristic typeId="ct-CmdUnit-Avail-Force" name="AvForce">Mid, Late Wars</characteristic>
                        <characteristic typeId="ct-CmdUnit-Avail-Army" name="AvArmy">Mid, Late Wars</characteristic>
                      </characteristics>
                    </profile>
                  </profiles>
                  <costs>
                    <cost typeId="esr-ct-Cohesion" name="Cohesion" value="2"/>
                    <cost typeId="esr-ct-Threat" name="Threat" value="3"/>
                  </costs>
