                    <infoLink name="Grand Battery" hidden="false" type="rule" targetId="708e-451c-8172-299c"/>
                    <infoLink name="Charmed Death" hidden="false" type="rule" targetId="aa54-af6b-495c-ff26"/>
                    <infoLink name="Peerless" hidden="false" type="rule" targetId="eee5-e63b-aaf3-e973"/>
