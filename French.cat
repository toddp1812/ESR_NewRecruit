                        <characteristic typeId="ct-CmdUnit-Avail-Formation" name="Availability Formation">Revolution</characteristic>
                        <characteristic typeId="ct-CmdUnit-Avail-Force" name="Force Force">Revolution, Early, Mid, Late Wars</characteristic>
                        <characteristic typeId="ct-CmdUnit-Avail-Army" name="Availability Army">–</characteristic>
                        <characteristic typeId="ct-CmdUnit-Cmd" name="Cmd">1</characteristic>
                        <characteristic typeId="ct-CmdUnit-Thr-LR" name="Thr-LR">1</characteristic>
