                  <profiles>
                    <profile name="Berthier" typeName="Commander" typeId="pt-CmdUnit">
                      <characteristics>
                        <characteristic typeId="ct-CmdUnit-Avail-Formation" name="Availability Formation">–</characteristic>
                        <characteristic typeId="ct-CmdUnit-Avail-Force" name="Force Force">–</characteristic>
                        <characteristic typeId="ct-CmdUnit-Avail-Army" name="Availability Army">Revolution, Early, Mid Wars</characteristic>
