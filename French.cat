                  <profiles>
                    <profile name="Junot" typeName="Commander" typeId="pt-CmdUnit">
                      <characteristics>
                        <characteristic typeId="ct-CmdUnit-Avail-Formation" name="Availability Formation">–</characteristic>
                        <characteristic typeId="ct-CmdUnit-Avail-Force" name="Force Force">Early, Mid Wars</characteristic>
                        <characteristic typeId="ct-CmdUnit-Avail-Army" name="Availability Army">–</characteristic>
                        <characteristic typeId="ct-CmdUnit-Cmd" name="Cmd">?</characteristic>
