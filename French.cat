                <selectionEntry type="model" import="true" name="Junot" hidden="false" id="fcfd-58c2-77a1-3dbd">
                  <profiles>
                    <profile name="Junot" typeName="Cmd Unit" typeId="pt-CmdUnit">
                      <characteristics>
                        <characteristic typeId="ct-CmdUnit-Cmd" name="Cmd">?</characteristic>
                        <characteristic typeId="ct-CmdUnit-Move" name="___Move___">24 | 18 | 9</characteristic>
                        <characteristic typeId="ct-CmdUnit-Thr-LR" name="Thr-LR">?</characteristic>
