                <selectionEntry type="model" import="true" name="Berthier" hidden="false" id="aeaa-131b-09ec-6161">
                  <profiles>
                    <profile name="Berthier" typeName="Cmd Unit" typeId="pt-CmdUnit">
                      <characteristics>
                        <characteristic typeId="ct-CmdUnit-Cmd" name="Cmd">1</characteristic>
                        <characteristic typeId="ct-CmdUnit-Move" name="___Move___">24 | 18 | 9</characteristic>
                        <characteristic typeId="ct-CmdUnit-Thr-LR" name="Thr-LR">0</characteristic>
                        <characteristic typeId="ct-CmdUnit-Thr-SR" name="Thr-SR">1</characteristic>
                        <characteristic typeId="ct-CmdUnit-Thr-C" name="Thr-C">1</characteristic>
                        <characteristic typeId="ct-CmdUnit-Coh" name="Coh">1</characteristic>
                        <characteristic typeId="ct-CmdUnit-Trait" name="Trait">&quot;Maréchal d’Empire; 1804-1815.
Dispatch ADCs; May replace Commanders and Harmed Maréchals with ADCs.
Major-général; If present, must act as chief-of-staﬀ to Napoléon, providing a
+1 to Napoléon’s Command when in contact, maximum of Command +4, 1796-1814.
Chosen Successor; If Napoléon is not present, or is removed by Leader Fate, Berthier must command the Army, does not suﬀer or trigger Maréchal penalties, 1796-1811.
An Inconvenient Death; He suspiciously falls from a window on 1 June, preventing him from participating in the final act of the Napoleonic Wars. Unavailable, 1815.&quot;</characteristic>
                        <characteristic typeId="ct-CmdUnit-Avail-Formation" name="AvForm">–</characteristic>
                        <characteristic typeId="ct-CmdUnit-Avail-Force" name="AvForce">–</characteristic>
                        <characteristic typeId="ct-CmdUnit-Avail-Army" name="AvArmy">Revolution, Early, Mid Wars</characteristic>
                      </characteristics>
                    </profile>
                  </profiles>
