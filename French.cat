            <selectionEntryGroup name="Historical Commander" id="2db8-2f1c-5107-691a" hidden="false" sortIndex="2">
              <selectionEntries>
                <selectionEntry type="model" import="true" name="Napoléon" hidden="false" id="cd04-7af4-c8e6-23e5">
                  <profiles>
                    <profile name="Napoléon" typeName="Commander" typeId="pt-CmdUnit">
                      <characteristics>
                        <characteristic typeId="ct-CmdUnit-Avail-Formation" name="Availability Formation">Revolution</characteristic>
                        <characteristic typeId="ct-CmdUnit-Avail-Force" name="Force Force">Revolution</characteristic>
                        <characteristic typeId="ct-CmdUnit-Avail-Army" name="Availability Army">Revolution, Early, Mid, Late Wars</characteristic>
                        <characteristic typeId="ct-CmdUnit-Cmd" name="Cmd">3</characteristic>
                        <characteristic typeId="ct-CmdUnit-Thr-LR" name="Thr-LR">3</characteristic>
                        <characteristic typeId="ct-CmdUnit-Thr-SR" name="Thr-SR">3</characteristic>
                        <characteristic typeId="ct-CmdUnit-Thr-C" name="Thr-C">3</characteristic>
                        <characteristic typeId="ct-CmdUnit-Coh" name="Coh">3</characteristic>
                        <characteristic typeId="ct-CmdUnit-Move" name="Move">24 | 18 | 9</characteristic>
                        <characteristic typeId="ct-CmdUnit-Trait" name="Trait">&quot;Peerless; If present, must be Army Commander, 1797-1815.
Les Grognards; At least one Garde des Consuls/Garde Impériale Formation is required, 1799-1815.
Charmed Death; +2 to Leader Fate.
Dispatch ADCs; May replace Commanders and Harmed Maréchals with ADCs.
Grand Battery; May command Grand Batteries.
Fate of an Empire; If Napoléon dies, the French lose, 1805-1815.&quot;</characteristic>
                      </characteristics>
                    </profile>
                  </profiles>
                  <costs>
                    <cost typeId="esr-ct-Cohesion" name="Cohesion" value="3"/>
                    <cost typeId="esr-ct-Threat" name="Threat" value="9"/>
                  </costs>
