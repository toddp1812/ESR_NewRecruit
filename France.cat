  <sharedRules>
    <rule name="Maréchal d’Empire" id="783d-f637-18c1-c980" hidden="false">
      <description>Subtract, not add, his Command if Issuer is another Maréchal (dates)</description>
    </rule>
    <rule name="Dispatch ADCs" id="59d6-4129-6e78-ff87" hidden="false">
      <description>May replace Commanders and Harmed Maréchals with ADCs.</description>
    </rule>
  </sharedRules>
