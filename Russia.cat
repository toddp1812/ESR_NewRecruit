  <sharedRules>
    <rule name="Close Enough" id="8a94-8939-f4ca-6472" hidden="false">
      <description>Neither triggers nor suﬀers Chistoi Russkoi penalties.</description>
    </rule>
    <rule name="Not from Around Here" id="a7f2-1b09-7216-0944" hidden="false">
      <description>Triggers Chistoi Russkoi penalties.</description>
    </rule>
    <rule name="Chistoi Russkoi" id="4d70-bb86-8bf6-037b" hidden="false">
      <description>Subtract, not add, Command Bonus unless the issuing Commander is also Chistoi Russkoi, or in contact with the Tsar.</description>
    </rule>
    <rule name="Almost like Family" id="6877-33aa-14d7-a393" hidden="false">
      <description>Neither triggers nor suﬀers Chistoi Russkoi penalties.</description>
    </rule>
    <rule name="Consummate Professional" id="3338-fdcb-cabc-3e66" hidden="false">
      <description>Neither triggers nor suﬀers Chistoi Russkoi penalties.</description>
    </rule>
  </sharedRules>
