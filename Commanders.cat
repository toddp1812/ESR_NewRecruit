                <selectionEntry type="model" import="true" name="Packenham" hidden="true" id="5a09de60-9baa-4ae7-a3e9-95e05bca2934">
                  <profiles>
                    <profile id="ececbfdd-eeb0-4a18-80b3-5667b0cb210e" name="Packenham" typeName="Cmd Unit" typeId="pt-CmdUnit">
                      <characteristics>
                        <characteristic typeId="ct-CmdUnit-Cmd" name="Cmd">1</characteristic>
                        <characteristic typeId="ct-CmdUnit-Move" name="___Move___">24 | 18 | 9</characteristic>
                        <characteristic typeId="ct-CmdUnit-Thr-LR" name="Thr-LR">0</characteristic>
                        <characteristic typeId="ct-CmdUnit-Thr-SR" name="Thr-SR">2</characteristic>
                        <characteristic typeId="ct-CmdUnit-Thr-C" name="Thr-C">1</characteristic>
                        <characteristic typeId="ct-CmdUnit-Coh" name="Coh">2</characteristic>
                        <characteristic typeId="ct-CmdUnit-Trait" name="Trait">Otherwise Engaged; Pakenham accepts command of British forces in North America at the end of the War of 1812. At the Battle of New Orleans, Pakenham is wounded by short range munitions from American artillery which explodes his knee, while being helped up by an aide, he is struck again in the arm. Once mounted on the aide’s horse he is struck a third time, this time in the spine. He dies shortly thereafter, after directing his second-in-command to take command and commit the reserves. Unavailable after August 1814.</characteristic>
                        <characteristic typeId="ct-CmdUnit-Avail-Formation" name="AvForm">Mid, Late Wars</characteristic>
                        <characteristic typeId="ct-CmdUnit-Avail-Force" name="AvForce">–</characteristic>
                        <characteristic typeId="ct-CmdUnit-Avail-Army" name="AvArmy">–</characteristic>
                      </characteristics>
                    </profile>
