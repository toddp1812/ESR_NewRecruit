                <selectionEntry type="model" import="true" name="Deroy" hidden="true" id="283133e9-4725-437c-b015-b70438990176">
                  <profiles>
                    <profile id="1c59fa15-a207-46c0-a749-9bbf11aa538f" name="Deroy" typeName="Cmd Unit" typeId="pt-CmdUnit">
                      <characteristics>
                        <characteristic typeId="ct-CmdUnit-Avail-Formation" name="AvForm">Early, Mid Wars</characteristic>
                        <characteristic typeId="ct-CmdUnit-Avail-Force" name="AvForce">–</characteristic>
                        <characteristic typeId="ct-CmdUnit-Avail-Army" name="AvArmy">–</characteristic>
                        <characteristic typeId="ct-CmdUnit-Cmd" name="Cmd">2</characteristic>
                        <characteristic typeId="ct-CmdUnit-Thr-LR" name="Thr-LR">1</characteristic>
                        <characteristic typeId="ct-CmdUnit-Thr-SR" name="Thr-SR">2</characteristic>
                        <characteristic typeId="ct-CmdUnit-Thr-C" name="Thr-C">1</characteristic>
                        <characteristic typeId="ct-CmdUnit-Coh" name="Coh">2</characteristic>
                        <characteristic typeId="ct-CmdUnit-Move" name="___Move___">24 | 18 | 9</characteristic>
                        <characteristic typeId="ct-CmdUnit-Trait" name="Trait">A Date with Death; Mortally wounded at Polotsk, -2 Leader Fate, 1812. Unavailable after August 1812.
A Last Gasp; After being gut shot at Polotsk, Deroy continues to lead his division through the end of the day&apos;s fighting. If severely wounded or killed as a result of Leader Fate, Deroy is not removed, his Command and Ranged Combat Bonuses become +0 and his Contact Combat and Cohesion Bonuses become +3. At the end of the day he is removed permanently.</characteristic>
                      </characteristics>
                    </profile>
                  </profiles>
                  <costs>
                    <cost typeId="esr-ct-Cohesion" name="Cohesion" value="2"/>
                    <cost typeId="esr-ct-Threat" name="Threat" value="4"/>
                  </costs>
                  <infoLinks>
                    <infoLink id="909f7885-4cee-4ac2-a196-9b068b2e6479" name="Date with Death" hidden="false" type="rule" targetId="1892-f4ae-e81a-5012"/>
                  </infoLinks>
