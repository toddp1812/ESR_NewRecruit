                <selectionEntry type="model" import="true" name="Junot" hidden="true" id="35a4a895-9929-45d2-b913-61bebe886a0f">
                  <profiles>
                    <profile id="c8aa9ad8-7b35-44e6-a3b0-84d23cf4e107" name="Junot" typeName="Cmd Unit" typeId="pt-CmdUnit">
                      <characteristics>
                        <characteristic typeId="ct-CmdUnit-Cmd" name="Cmd">?</characteristic>
                        <characteristic typeId="ct-CmdUnit-Move" name="___Move___">24 | 18 | 9</characteristic>
                        <characteristic typeId="ct-CmdUnit-Thr-LR" name="Thr-LR">?</characteristic>
