  <sharedRules>
    <rule name="Maréchal d’Empire" id="542d-6b1e-1cd8-b00b" hidden="false">
      <description>Subtract, not add, his Command if Issuer is another Maréchal (dates)</description>
    </rule>
    <rule name="Dispatch ADCs" id="46aa-5ea0-4690-a387" hidden="false">
      <description>May replace Commanders and Harmed Maréchals with ADCs.</description>
    </rule>
    <rule name="Almost like Family" id="8251-a010-7f5b-d71e" hidden="false">
      <description>Neither triggers nor suﬀers Chistoi Russkoi penalties.</description>
    </rule>
    <rule name="Chistoi Russkoi" id="2a1a-4958-7290-cb65" hidden="false">
      <description>Subtract, not add, Command Bonus unless the issuing Commander is also Chistoi Russkoi, or in contact with the Tsar.</description>
    </rule>
    <rule name="Close Enough" id="9b70-c11d-75a6-72ee" hidden="false">
      <description>Neither triggers nor suﬀers Chistoi Russkoi penalties.</description>
    </rule>
    <rule name="Consummate Professional" id="38f5-8069-5c96-bad4" hidden="false">
      <description>Neither triggers nor suﬀers Chistoi Russkoi penalties.</description>
    </rule>
    <rule name="Not from Around Here" id="da26-e95d-a729-2e87" hidden="false">
      <description>Triggers Chistoi Russkoi penalties.</description>
    </rule>
  </sharedRules>
  <rules>
    <rule name="New Rule" id="3806-d43f-a426-d8a4" hidden="false">
      <modifiers>
        <modifier type="set" value="true" field="hidden">
          <conditions>
            <condition type="atLeast" value="1" field="selections" scope="self" childId="any" shared="true"/>
          </conditions>
        </modifier>
      </modifiers>
    </rule>
  </rules>
