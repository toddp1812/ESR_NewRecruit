                  <profiles>
                    <profile id="c2806109-ab0c-4cea-b5ae-452c10a50df8" name="Konstantin" typeName="Cmd Unit" typeId="pt-CmdUnit">
                      <characteristics>
                        <characteristic typeId="ct-CmdUnit-Cmd" name="Cmd">1</characteristic>
