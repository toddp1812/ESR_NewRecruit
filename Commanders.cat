                <selectionEntry type="model" import="true" name="Knorring-1" hidden="true" id="33199616-1750-4c5e-8306-415e6481b2d3">
                  <profiles>
                    <profile id="1b15e8cc-1b4c-4306-8db2-bd7a1ba28446" name="Knorring-1" typeName="Cmd Unit" typeId="pt-CmdUnit">
                      <characteristics>
                        <characteristic typeId="ct-CmdUnit-Cmd" name="Cmd">1</characteristic>
                        <characteristic typeId="ct-CmdUnit-Move" name="___Move___">24 | 18 | 9</characteristic>
