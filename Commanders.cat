                <selectionEntry type="model" import="true" name="Mack" hidden="true" id="41b47e8a-f10e-4c46-96d5-09e14631db6c">
                  <profiles>
                    <profile id="55e69ea1-4a62-4e30-80c1-d8f6df02f0f1" name="Mack" typeName="Cmd Unit" typeId="pt-CmdUnit">
                      <characteristics>
                        <characteristic typeId="ct-CmdUnit-Cmd" name="Cmd">1</characteristic>
                        <characteristic typeId="ct-CmdUnit-Move" name="___Move___">24 | 18 | 9</characteristic>
                        <characteristic typeId="ct-CmdUnit-Thr-LR" name="Thr-LR">0</characteristic>
