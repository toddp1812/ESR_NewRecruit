                        <characteristic typeId="ct-CmdUnit-Coh" name="Coh">3</characteristic>
                        <characteristic typeId="ct-CmdUnit-Trait" name="Trait">Daddy Hill; If in Personal Command roll 1D6 during Recovery, on a ‘6’, the Formation Recovers -2 instead of -1 Fatigue.</characteristic>
                        <characteristic typeId="ct-CmdUnit-Avail-Formation" name="AvForm">Early, Mid, Late Wars</characteristic>
                        <characteristic typeId="ct-CmdUnit-Avail-Force" name="AvForce">Mid, Late Wars</characteristic>
