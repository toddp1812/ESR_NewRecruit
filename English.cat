            <selectionEntryGroup name="Historical Commander" id="0a90-2e0a-87b7-994a" hidden="false">
              <selectionEntries>
                <selectionEntry type="model" import="true" name="Moore" hidden="false" id="5378-ead2-6198-db38">
                  <profiles>
                    <profile name="Moore" typeName="Commander" typeId="pt-CmdUnit">
                      <characteristics>
                        <characteristic typeId="ct-CmdUnit-Avail-Formation" name="Availability Formation">Revolution, Early War</characteristic>
                        <characteristic typeId="ct-CmdUnit-Avail-Force" name="Force Force">Revolution, Early, Mid Wars</characteristic>
                        <characteristic typeId="ct-CmdUnit-Avail-Army" name="Availability Army">Revolution, Early, Mid Wars</characteristic>
                        <characteristic typeId="ct-CmdUnit-Cmd" name="Cmd">2</characteristic>
                        <characteristic typeId="ct-CmdUnit-Thr-LR" name="Thr-LR">0</characteristic>
                        <characteristic typeId="ct-CmdUnit-Thr-SR" name="Thr-SR">1</characteristic>
                        <characteristic typeId="ct-CmdUnit-Thr-C" name="Thr-C">2</characteristic>
                        <characteristic typeId="ct-CmdUnit-Coh" name="Coh">2</characteristic>
                        <characteristic typeId="ct-CmdUnit-Move" name="Move">24 | 18 | 9</characteristic>
                        <characteristic typeId="ct-CmdUnit-Trait" name="Trait">A Date with Death; Moore is mortally wounded by artillery fire at Coruña and dies shortly after the battle ends. Once the British vacated Coruña, Maréchal Soult orders the French army  to build a monument over Moore’s grave to honor their opponent, -2 to Leader Fate, 1809. Unavailable after January 1809.</characteristic>
                      </characteristics>
                    </profile>
                  </profiles>
                  <costs>
                    <cost typeId="esr-ct-Cohesion" name="Cohesion" value="2"/>
                    <cost typeId="esr-ct-Threat" name="Threat" value="3"/>
                  </costs>
                  <infoLinks>
                    <infoLink name="A Date with Death" hidden="false" type="rule" targetId="1892-f4ae-e81a-5012"/>
                  </infoLinks>
                </selectionEntry>
                <selectionEntry type="model" import="true" name="Wellington" hidden="false" id="1030-a038-ff43-1ec1">
                  <profiles>
                    <profile name="Wellington" typeName="Commander" typeId="pt-CmdUnit">
                      <characteristics>
                        <characteristic typeId="ct-CmdUnit-Avail-Formation" name="Availability Formation">Revolution</characteristic>
                        <characteristic typeId="ct-CmdUnit-Avail-Force" name="Force Force">Revolution, Early, Mid, Late Wars</characteristic>
                        <characteristic typeId="ct-CmdUnit-Avail-Army" name="Availability Army">Mid, Late Wars</characteristic>
                        <characteristic typeId="ct-CmdUnit-Cmd" name="Cmd">3</characteristic>
                        <characteristic typeId="ct-CmdUnit-Thr-LR" name="Thr-LR">0</characteristic>
                        <characteristic typeId="ct-CmdUnit-Thr-SR" name="Thr-SR">3</characteristic>
                        <characteristic typeId="ct-CmdUnit-Thr-C" name="Thr-C">3</characteristic>
                        <characteristic typeId="ct-CmdUnit-Coh" name="Coh">3</characteristic>
                        <characteristic typeId="ct-CmdUnit-Move" name="Move">24 | 18 | 9</characteristic>
                        <characteristic typeId="ct-CmdUnit-Trait" name="Trait">&quot;Charmed Death; +2 to Leader Fate, 1808-1815.
Peerless; If present, must be Army Commander, 1809-1815.
Limited Delegation; Wellington’s Army is limited to a maximum of two English Forces: the first must be commanded by Wellington, a second must be a Cavalry Force, any additional Forces must be Spanish, 1809-1812.&quot;</characteristic>
                      </characteristics>
                    </profile>
                  </profiles>
                  <costs>
                    <cost typeId="esr-ct-Cohesion" name="Cohesion" value="3"/>
                    <cost typeId="esr-ct-Threat" name="Threat" value="6"/>
                  </costs>
                  <infoLinks>
                    <infoLink name="Charmed Death" hidden="false" type="rule" targetId="aa54-af6b-495c-ff26"/>
                    <infoLink name="Peerless" hidden="false" type="rule" targetId="eee5-e63b-aaf3-e973"/>
                  </infoLinks>
                </selectionEntry>
                <selectionEntry type="model" import="true" name="Hill" hidden="false" id="4235-2d5d-9946-fd8a">
                  <profiles>
                    <profile name="Hill" typeName="Commander" typeId="pt-CmdUnit">
                      <characteristics>
                        <characteristic typeId="ct-CmdUnit-Avail-Formation" name="Availability Formation">Early, Mid, Late Wars</characteristic>
                        <characteristic typeId="ct-CmdUnit-Avail-Force" name="Force Force">Mid, Late Wars</characteristic>
                        <characteristic typeId="ct-CmdUnit-Avail-Army" name="Availability Army">Late War</characteristic>
                        <characteristic typeId="ct-CmdUnit-Cmd" name="Cmd">2</characteristic>
                        <characteristic typeId="ct-CmdUnit-Thr-LR" name="Thr-LR">1</characteristic>
                        <characteristic typeId="ct-CmdUnit-Thr-SR" name="Thr-SR">2</characteristic>
                        <characteristic typeId="ct-CmdUnit-Thr-C" name="Thr-C">2</characteristic>
                        <characteristic typeId="ct-CmdUnit-Coh" name="Coh">3</characteristic>
                        <characteristic typeId="ct-CmdUnit-Move" name="Move">24 | 18 | 9</characteristic>
                        <characteristic typeId="ct-CmdUnit-Trait" name="Trait">Daddy Hill; If in Personal Command roll 1D6 during Recovery, on a ‘6’, the Formation Recovers -2 instead of -1 Fatigue.</characteristic>
                      </characteristics>
                    </profile>
                  </profiles>
                  <costs>
                    <cost typeId="esr-ct-Cohesion" name="Cohesion" value="3"/>
                    <cost typeId="esr-ct-Threat" name="Threat" value="5"/>
                  </costs>
                </selectionEntry>
                <selectionEntry type="model" import="true" name="Craufurd" hidden="false" id="b1fe-51f3-6ef9-c9b0">
                  <profiles>
                    <profile name="Craufurd" typeName="Commander" typeId="pt-CmdUnit">
                      <characteristics>
                        <characteristic typeId="ct-CmdUnit-Avail-Formation" name="Availability Formation">Early, Mid Wars</characteristic>
                        <characteristic typeId="ct-CmdUnit-Avail-Force" name="Force Force">–</characteristic>
                        <characteristic typeId="ct-CmdUnit-Avail-Army" name="Availability Army">–</characteristic>
                        <characteristic typeId="ct-CmdUnit-Cmd" name="Cmd">3</characteristic>
                        <characteristic typeId="ct-CmdUnit-Thr-LR" name="Thr-LR">1</characteristic>
                        <characteristic typeId="ct-CmdUnit-Thr-SR" name="Thr-SR">3</characteristic>
                        <characteristic typeId="ct-CmdUnit-Thr-C" name="Thr-C">3</characteristic>
                        <characteristic typeId="ct-CmdUnit-Coh" name="Coh">3</characteristic>
                        <characteristic typeId="ct-CmdUnit-Move" name="Move">24 | 18 | 9</characteristic>
                        <characteristic typeId="ct-CmdUnit-Trait" name="Trait">&quot;By Popular Demand; Craufurd must command the Light Division, 1810-1812. Black Bob; The Light Division gains Rapid Deployment and either Enthusiastic or Stoic, the controlling player must choose at the start of the game.
Outpost Duty; French Forces within 1 mile (12”) of Light Division may not use dummy Objective markers.
A Date with Death; Craufurd is mortally wounded at Ciudad Rodrigo, dying four days later. -2 to Leader Fate, 1812. Unavailable after January 1812.&quot;</characteristic>
                      </characteristics>
                    </profile>
                  </profiles>
                  <costs>
                    <cost typeId="esr-ct-Cohesion" name="Cohesion" value="3"/>
                    <cost typeId="esr-ct-Threat" name="Threat" value="7"/>
                  </costs>
                  <infoLinks>
                    <infoLink name="A Date with Death" hidden="false" type="rule" targetId="1892-f4ae-e81a-5012"/>
                  </infoLinks>
                </selectionEntry>
                <selectionEntry type="model" import="true" name="Beresford" hidden="false" id="67d3-0912-a1b2-c5ee">
                  <profiles>
                    <profile name="Beresford" typeName="Commander" typeId="pt-CmdUnit">
                      <characteristics>
                        <characteristic typeId="ct-CmdUnit-Avail-Formation" name="Availability Formation">Mid, Late Wars</characteristic>
                        <characteristic typeId="ct-CmdUnit-Avail-Force" name="Force Force">Mid, Late Wars</characteristic>
                        <characteristic typeId="ct-CmdUnit-Avail-Army" name="Availability Army">Mid, Late Wars</characteristic>
